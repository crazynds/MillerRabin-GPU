# params.cmake — build configuration for MillerRabinGPU.
#
# Copy this file to params.cmake, edit, then re-run CMake:
#
#   cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j
#
# Every parameter is documented in docs/configuration.md, in this same order.
# The one-liners here are reminders, not the reference — when in doubt, read the
# doc rather than guessing from the comment.
#
# Sections are ordered by how often they are worth touching: problem sizing
# first, micro-tuning last.

# ══════════════════════════════════════════════════════════════════════════════
# [Number representation]
# ══════════════════════════════════════════════════════════════════════════════

# Bits per limb. The highest-leverage knob: pick it so 2*n_limbs lands just under
# a power of two. The binary warns at startup when it does not. Range 4-30.
set(LIMB_BITS 22)

# Store limbs as uint32 instead of uint64. Halves limb-side traffic and power-table VRAM.
set(MR_LIMB32 ON)

# ══════════════════════════════════════════════════════════════════════════════
# [Batching and exponentiation]
# ══════════════════════════════════════════════════════════════════════════════

# Candidates per GPU launch. Higher = better utilization, higher peak VRAM.
set(MR_BATCH_SIZE 256)

# Sliding-window width for base^exp mod N; the power table holds 2^N entries. Range 4-10.
set(MR_WINDOW_BITS 8)

# ══════════════════════════════════════════════════════════════════════════════
# [Algorithm selection]
# ══════════════════════════════════════════════════════════════════════════════

# Big-integer multiplication backend.
# MUL_MERGE_GPUNTT | MUL_4STEP_GPUNTT | MUL_FFT_CUFFT | MUL_FFT_GPUFFT |
# MUL_FFNT_GPUFFT | MUL_SCHOOLBOOK
set(MUL_ALG MUL_MERGE_GPUNTT)

# Modular reduction used by every modmul/modsq.  MOD_RED_BARRETT | MOD_RED_MONTGOMERY
set(MOD_REDUCTION_ALG MOD_RED_BARRETT)

# Carry normalization after each multiplication.
# CARRY_ALG_MULTI_TILE | CARRY_ALG_SINGLE_TILE | CARRY_ALG_SEQUENTIAL | CARRY_ALG_PREFIX_SCAN
set(CARRY_NORM_ALG CARRY_ALG_MULTI_TILE)

# ══════════════════════════════════════════════════════════════════════════════
# [MUL_MERGE_GPUNTT NTT tuning]
#   All of these need MUL_MERGE_GPUNTT and are silently ignored otherwise.
#   They are ON in production
# ══════════════════════════════════════════════════════════════════════════════

# Fuse the zero-padded gather into the first forward-NTT kernel.
set(MR_NTT_FUSED_PAD   ON)

# Fuse the NTT-domain pointwise multiply/square into the first INTT kernel.
set(MR_NTT_FUSED_PMUL  ON)

# Fuse the Barrett right-shift into the forward-NTT gather. Needs FUSED_PAD + Barrett.
set(MR_NTT_FUSED_SHIFT ON)

# Shoup (precomputed-quotient) butterflies: three 64-bit multiplies, not three 128-bit.
set(MR_NTT_SHOUP ON)

# Harvey lazy reduction: one conditional subtract per butterfly instead of three.
set(MR_NTT_LAZY ON)

# Evaluate q*p by shift/add using the merge prime's sparse form. Needs that exact prime.
set(MR_NTT_SPARSE_P ON)

# ══════════════════════════════════════════════════════════════════════════════
# [GPU-NTT library]
# ══════════════════════════════════════════════════════════════════════════════

# Kernel tables tuned for Compute Capability 8.9 (RTX 4090). Set OFF on other GPUs.
set(GPUNTT_CC89 ON)

# Batch layout inside the NTT buffers.  PerPolynomial | PerCoefficient
set(GPUNTT_NTT_LAYOUT PerPolynomial)

# ══════════════════════════════════════════════════════════════════════════════
# [Kernel tiling]
# ══════════════════════════════════════════════════════════════════════════════

# Tile width for the SINGLE_TILE / MULTI_TILE carry kernels. Multiple of 32.
set(MR_CARRY_TILE 512)

# Threads for MULTI_TILE phase 2 (inter-tile carry). Low on purpose: bandwidth-bound.
set(MR_CARRY_INTER_THR 64)

# Tile width for cond_sub_batch (cs_phase1 + cs_apply). Multiple of 32.
set(MR_SUB_TILE 256)

# ══════════════════════════════════════════════════════════════════════════════
# [Kernel thread counts]
#   All must be multiples of 32.
# ══════════════════════════════════════════════════════════════════════════════

set(MR_THR_LOAD        512)  # load_padded_batch: gather into the NTT buffer
set(MR_THR_PMUL        256)  # pmul_batch / psq_batch (unused while MR_NTT_FUSED_PMUL is ON)
set(MR_THR_ADD         256)  # vadd_batch: element-wise add of raw coefficients
set(MR_THR_SELECT_WIN  32)   # select_window_kernel: pick the power-table entry
set(MR_THR_CHECK       64)   # check_equals_kernel: compare r against N-1 or 1
set(MR_THR_COPY        512)  # result copy-out

# ══════════════════════════════════════════════════════════════════════════════
# [Compiler]
# ══════════════════════════════════════════════════════════════════════════════

# nvcc -maxrregcount. 0 = no limit. Lower raises occupancy but risks register spilling.
set(MR_MAXRREGCOUNT 0)

# ══════════════════════════════════════════════════════════════════════════════
# [Monitoring]
# ══════════════════════════════════════════════════════════════════════════════

# Minimum milliseconds between --progress screen updates.
set(MR_PROGRESS_INTERVAL_MS 2000)

# Print per-batch carry statistics. Adds printf overhead; keep OFF in production.
set(MR_ADVANCED_MONITOR OFF)
